# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Backend Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:5500

# Firebase / Firestore (Optional for local file-based storage fallback)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=path/to/serviceAccountKey.json
USE_LOCAL_DATA_STORE=true

# Pilot Configuration (Default: India)
DEFAULT_COUNTRY=IND
PILOT_ADMIN1_REGIONS=Maharashtra,Uttar Pradesh
